# ─────────────────────────────────────────────────────────────
#  Wanderly — variables d'environnement
#  Copie ce fichier en `.env.local` puis remplis ce que tu as.
#  L'app TOURNE SANS AUCUNE clé : tout est mocké par défaut.
#  Chaque clé ci-dessous active une intégration réelle.
# ─────────────────────────────────────────────────────────────

# ── IA — Assistant concierge ───────────────────────────────────
# Sans clé : concierge déterministe local (démo complète).
# Avec clé : réponses Claude réelles + function calling.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHAT=claude-sonnet-4-6
ANTHROPIC_MODEL_PLANNER=claude-opus-4-7

# ── Supabase — auth, DB Postgres, storage, realtime ───────────
# Schéma fourni dans supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe — abonnements + paiements + crédits ────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EXPLORER=
STRIPE_PRICE_GLOBETROTTER=

# ── Cartographie ──────────────────────────────────────────────
# La carte /map fonctionne sans token (react-simple-maps + topojson local).
# Token optionnel si tu remplaces par Mapbox GL.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Recherche externe (vols / logements / restos / activités) ──
# Sans clé : résultats mockés réalistes via /api/search/unified.
DUFFEL_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
BOOKING_API_KEY=
APIFY_TOKEN=
GOOGLE_PLACES_API_KEY=
GETYOURGUIDE_PARTNER_ID=

# ── Cache prix (Upstash Redis, TTL 30 min) ────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Images ────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=
